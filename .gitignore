.DS_Store
__pycache__/
*.pyc
.claude/settings.local.json
.venv/

# 재생성 가능한 실행 산출물 (rule_layer.py / build_review_sheet.py 등)
eval/results/*.jsonl
eval/results/*.csv
eval/results/review_criteria.txt

# run_all.py 가 실행 때마다 만드는 산출물
eval/results/REPORT_*.txt
eval/results/_metrics_*.json
eval/results/_smoke_gold_*.json

# 복원 스크립트가 --write 없이 만드는 대조용 산출물 (원본과 동일)
*.json.new

# 로컬 전용 작업 규칙 (원격 리포에 올리지 않음)
CLAUDE.md
